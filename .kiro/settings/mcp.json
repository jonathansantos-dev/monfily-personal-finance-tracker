{
  "mcpServers": {
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "disabled": false,
      "autoApprove": [
        "get_file_contents",
        "search_repositories",
        "search_code",
        "list_commits",
        "get_me"
      ]
    }
  }
}
